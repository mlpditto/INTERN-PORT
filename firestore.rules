rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerFromResource() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isOwnerFromRequest() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Default: Deny all unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Knowledge Base (existing collection)
    match /knowledge_base/{id} {
      allow read, write: if request.auth != null;
    }

    // Podcast episodes (new collection for V90.38+)
    match /podcasts/{id} {
      allow read, write: if request.auth != null;
    }

    // System metadata (storage usage, settings)
    match /_meta/{id} {
      allow read, write: if request.auth != null;
    }

    // Research history and other authenticated resources
    match /research_history/{id} {
      allow read, write: if request.auth != null;
    }

    // User profiles and data
    match /users/{id} {
      allow read, write: if request.auth != null;
    }

    // Quiz and assessment data
    match /quizzes/{id} {
      allow read, write: if request.auth != null;
    }

    match /quiz_responses/{id} {
      allow read, write: if request.auth != null;
    }

    // Assignments collection
    match /assignments/{id} {
      allow read, write: if request.auth != null;
    }

    // Projects collection
    match /projects/{id} {
      allow read, write: if request.auth != null;
    }

    // Poneglyph notes are owner-scoped only
    match /poneglyph_notes/{id} {
      allow create: if isOwnerFromRequest();
      allow read, delete: if isOwnerFromResource();
      allow update: if isOwnerFromResource()
                    && isOwnerFromRequest()
                    && request.resource.data.ownerId == resource.data.ownerId;
    }

    // Catch-all for other authenticated collections
    match /{path=**} {
      allow read, write: if isSignedIn() && !(path.size() > 0 && path[0] == "poneglyph_notes");
    }
  }
}
