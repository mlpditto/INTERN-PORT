rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ ฟังก์ชันเช็ค Admin (custom claims first, email fallback for transition)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'medlifeplus@gmail.com'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerByAuthUid() {
      return isSignedIn() && resource.data.authUid == request.auth.uid;
    }

    function hasLinkedEffectiveUserId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/user_auth_links/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_auth_links/$(request.auth.uid)).data.effectiveUserId == resource.data.userId;
    }

    function hasAuthLinkToUserId(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/user_auth_links/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_auth_links/$(request.auth.uid)).data.effectiveUserId == userId;
    }

    // 1. Users
    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId || hasAuthLinkToUserId(userId);
      allow create, update: if isAdmin() || request.auth.uid == userId || hasAuthLinkToUserId(userId);
      allow delete: if isAdmin();
    }

    // 2. Works
    match /works/{workId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authUid == request.auth.uid);
    }

    // 3. Quests
    match /quests/{questId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Quest Submissions
    match /quest_submissions/{subId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    
    // 5. Check-in Logs
    match /checkin_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    
    // 6. Side Quests
    match /side_quests/{taskId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
      
      match /comments/{commentId} {
        allow read, create: if true;
      }
    }
    
    // 7. Reports
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 8. Quizzes
    match /quizzes/{quizId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 9. Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow create, update, read: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 10. Poll Responses
    match /poll_responses/{pollId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. Pre Users
    match /pre_users/{docId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 12. Quiz Feedback
    match /quiz_feedback/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // 13. Reflective Logs
    match /reflective_logs/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 🔥 14. Knowledge Base (เพิ่มใหม่สำหรับระบบวิจัย V86.35)
    match /knowledge_base/{docId} {
      allow read, write: if isAdmin();
    }

    // 15. Podcast Studio
    match /podcasts/{docId} {
      allow read, write: if isAdmin();
    }

    // 16. Admin metadata (e.g. storage usage counters)
    match /_meta/{docId} {
      allow read, write: if isAdmin();
    }
    // 17. Cases (Patient Case Submissions from LIFF)
    match /cases/{docId} {
      // isOwnerByAuthUid()         → works for query: where("authUid","==",authUser.uid)
      // hasLinkedEffectiveUserId() → works for query: where("userId","==",userId) via user_auth_links lookup
      allow read: if isAdmin() || isOwnerByAuthUid() || hasLinkedEffectiveUserId();
      allow create: if isSignedIn() && request.resource.data.authUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 18. Admin Notifications (generated by LIFF actions)
    match /admin_notifications/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // 19. Quiz Discussions (LIFF discussion threads)
    match /quiz_discussions/{discussionId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // 20. Poneglyph Notes (Admin notes system)
    match /poneglyph_notes/{docId} {
      allow read, write: if isAdmin();
    }

    // 23. Learning Path Entries (PONEGLYPH learning path system)
    // V92.09: Admin inline edit + audit trail. editHistory[] and lastAdminEdit{} are
    // append-only audit fields — non-admin writers (the entry owner) cannot create or
    // modify them. Admin can append to editHistory but cannot shrink it.
    match /learning_path_entries/{docId} {
      function auditFieldsUnchanged() {
        return request.resource.data.get('editHistory', []) == resource.data.get('editHistory', [])
          && request.resource.data.get('lastAdminEdit', null) == resource.data.get('lastAdminEdit', null);
      }
      function auditAppendOnly() {
        return request.resource.data.get('editHistory', []).size() >= resource.data.get('editHistory', []).size();
      }
      allow read: if isAdmin() || hasAuthLinkToUserId(resource.data.userId) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if (isAdmin() || (isSignedIn() && (request.resource.data.userId == request.auth.uid || hasAuthLinkToUserId(request.resource.data.userId))))
        && !('editHistory' in request.resource.data)
        && !('lastAdminEdit' in request.resource.data);
      allow update: if (isAdmin() && auditAppendOnly())
        || (isSignedIn() && (resource.data.userId == request.auth.uid || hasAuthLinkToUserId(resource.data.userId)) && auditFieldsUnchanged());
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || hasAuthLinkToUserId(resource.data.userId)));
    }

    // 24. Learning Paths (AI-generated paths)
    match /learning_paths/{docId} {
      allow read: if isAdmin() || hasAuthLinkToUserId(resource.data.userId) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && (request.resource.data.userId == request.auth.uid || hasAuthLinkToUserId(request.resource.data.userId)));
      allow update, delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || hasAuthLinkToUserId(resource.data.userId)));
    }

    // 21. Auth link registry for legacy data migration
    match /user_auth_links/{authUid} {
      allow read: if isAdmin() || (isSignedIn() && authUid == request.auth.uid);
      allow create, update: if isSignedIn()
        && authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 22. Daily quiz bonus status for LIFF Voyage Metrics notification
    match /daily_bonus_quiz/{dateKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/daily_bonus_quiz/$(dateKey))
        && request.resource.data.claimed == true
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.claimedBy is string
        && request.resource.data.amount == 0.1
        && request.resource.data.dateKey == dateKey;
      allow update, delete: if isAdmin();
    }

    // 25. Unified Submissions (V91.62+ Phase 2 — Case/Work/Quiz/Quest/Reflective/Learning Note)
    // V94.09: Match reflective_logs (rule 13) pattern — single-query onSnapshot at
    // loadUnifiedSubmissions() (public/index.html:9912) uses where('userId','==',userId)
    // only. Stricter cases-style rule (V94.08 attempt) required TWO parallel queries
    // (authUid + userId, see loadMyCases at line 11581-11583); single-query against the
    // owner-or-linked OR rule was rejected by Firestore's query-alignment check.
    // Privacy posture: same as reflective_logs — any signed-in user can read all
    // submissions. Tightening would require allow-get/allow-list split or JS query
    // refactor (out of scope for this hotfix).
    match /submissions/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();

      // V91.75 γ.4a: Conversation thread between admin and student on a review.
      // Each message records its author so a student can never impersonate admin.
      // Read is open to any signed-in user (matches parent rule); create requires
      // authorUid == request.auth.uid; update/delete admin-only.
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000;
        allow update, delete: if isAdmin();
      }
    }
  }
}
