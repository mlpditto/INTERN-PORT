rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ ฟังก์ชันเช็ค Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'medlifeplus@gmail.com';
    }

    // 1. Users
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 2. Works
    match /works/{workId} {
      allow read, create: if true;
      allow update, delete: if true; 
    }

    // 3. Quests
    match /quests/{questId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Quest Submissions
    match /quest_submissions/{subId} {
      allow read, create, update: if true;
      allow delete: if true; 
    }
    
    // 5. Check-in Logs
    match /checkin_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    
    // 6. Side Quests
    match /side_quests/{taskId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
      
      match /comments/{commentId} {
        allow read, create: if true;
      }
    }
    
    // 7. Reports
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 8. Quizzes
    match /quizzes/{quizId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 9. Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow create, update, read: if true;
      allow delete: if true;
    }

    // 10. Poll Responses
    match /poll_responses/{pollId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. Pre Users
    match /pre_users/{docId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 12. Quiz Feedback
    match /quiz_feedback/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // 13. Reflective Logs
    match /reflective_logs/{docId} {
      allow read, create: if true;
      allow update, delete: if true; 
    }

    // 🔥 14. Knowledge Base (เพิ่มใหม่สำหรับระบบวิจัย V86.35)
    match /knowledge_base/{docId} {
      allow read, write: if isAdmin();
    }

    // 15. Podcast Studio
    match /podcasts/{docId} {
      allow read, write: if isAdmin();
    }

    // 16. Admin metadata (e.g. storage usage counters)
    match /_meta/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
