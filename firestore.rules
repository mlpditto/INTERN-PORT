rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ ฟังก์ชันเช็ค Admin (custom claims first, email fallback for transition)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'medlifeplus@gmail.com'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerByAuthUid() {
      return isSignedIn() && resource.data.authUid == request.auth.uid;
    }

    // V94.82: also accept rawLiffUserId so a case tagged with the raw LIFF
    // userId stays readable after admin-side legacy-user linking flips
    // effectiveUserId to a different value (Joeylive scenario). Both fields
    // live on the same user_auth_links/{authUid} doc that's already upserted
    // on every LIFF login — no migration needed.
    function hasLinkedEffectiveUserId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/user_auth_links/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/user_auth_links/$(request.auth.uid)).data.effectiveUserId == resource.data.userId
          || get(/databases/$(database)/documents/user_auth_links/$(request.auth.uid)).data.rawLiffUserId == resource.data.userId
        );
    }

    function hasAuthLinkToUserId(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/user_auth_links/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_auth_links/$(request.auth.uid)).data.effectiveUserId == userId;
    }

    // 1. Users
    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId || hasAuthLinkToUserId(userId);
      allow create, update: if isAdmin() || request.auth.uid == userId || hasAuthLinkToUserId(userId);
      allow delete: if isAdmin();
    }

    // 2. Works
    match /works/{workId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authUid == request.auth.uid);
    }

    // 3. Quests
    match /quests/{questId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Quest Submissions
    match /quest_submissions/{subId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    
    // 5. Check-in Logs
    match /checkin_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // 5b. Material download click log (V95.63) — one doc per click written by the
    // intern when they open a quiz's 📎 attachment; admin aggregates distinct users +
    // per-file counts. Write-only for signed-in interns; admin-only read so the
    // analytics aren't world-readable.
    match /material_clicks/{clickId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 6. Side Quests
    match /side_quests/{taskId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
      
      match /comments/{commentId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // 7. Reports
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 8. Quizzes
    match /quizzes/{quizId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 9. Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow create, update, read: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 10. Poll Responses
    match /poll_responses/{pollId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. Pre Users
    match /pre_users/{docId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 12. Quiz Feedback
    match /quiz_feedback/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // 13. Reflective Logs
    match /reflective_logs/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 🔥 14. Knowledge Base (เพิ่มใหม่สำหรับระบบวิจัย V86.35)
    match /knowledge_base/{docId} {
      allow read, write: if isAdmin();
    }

    // 15. Podcast Studio
    match /podcasts/{docId} {
      allow read, write: if isAdmin();
    }

    // 16. Admin metadata (e.g. storage usage counters)
    match /_meta/{docId} {
      allow read, write: if isAdmin();
    }
    // 17. Cases (Patient Case Submissions from LIFF)
    match /cases/{docId} {
      // isOwnerByAuthUid()         → works for query: where("authUid","==",authUser.uid)
      // hasLinkedEffectiveUserId() → works for query: where("userId","==",userId) via user_auth_links lookup
      allow read: if isAdmin() || isOwnerByAuthUid() || hasLinkedEffectiveUserId();
      allow create: if isSignedIn() && request.resource.data.authUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 18. Admin Notifications (generated by LIFF actions)
    match /admin_notifications/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // 19. Quiz Discussions (LIFF discussion threads)
    match /quiz_discussions/{discussionId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // 20. Poneglyph Notes (Admin notes system)
    match /poneglyph_notes/{docId} {
      allow read, write: if isAdmin();
    }

    // 25. TTS Voice Presets (OmniVoice Phase 2.1 — per-admin reusable voice cloning refs)
    // Read is broad-admin (the client filters by createdBy in its query so each admin
    // sees only their own list). Mutations are uid-scoped: only the creator can update
    // or delete a preset. createdBy is locked to request.auth.uid on create.
    match /tts_voice_presets/{presetId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.createdBy == request.auth.uid;
    }

    // 23. Learning Path Entries (PONEGLYPH learning path system)
    // V92.09: Admin inline edit + audit trail. editHistory[] and lastAdminEdit{} are
    // append-only audit fields — non-admin writers (the entry owner) cannot create or
    // modify them. Admin can append to editHistory but cannot shrink it.
    match /learning_path_entries/{docId} {
      function auditFieldsUnchanged() {
        return request.resource.data.get('editHistory', []) == resource.data.get('editHistory', [])
          && request.resource.data.get('lastAdminEdit', null) == resource.data.get('lastAdminEdit', null);
      }
      function auditAppendOnly() {
        return request.resource.data.get('editHistory', []).size() >= resource.data.get('editHistory', []).size();
      }
      allow read: if isAdmin() || hasAuthLinkToUserId(resource.data.userId) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if (isAdmin() || (isSignedIn() && (request.resource.data.userId == request.auth.uid || hasAuthLinkToUserId(request.resource.data.userId))))
        && !('editHistory' in request.resource.data)
        && !('lastAdminEdit' in request.resource.data);
      allow update: if (isAdmin() && auditAppendOnly())
        || (isSignedIn() && (resource.data.userId == request.auth.uid || hasAuthLinkToUserId(resource.data.userId)) && auditFieldsUnchanged());
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || hasAuthLinkToUserId(resource.data.userId)));
    }

    // 24. Learning Paths (AI-generated paths)
    match /learning_paths/{docId} {
      allow read: if isAdmin() || hasAuthLinkToUserId(resource.data.userId) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && (request.resource.data.userId == request.auth.uid || hasAuthLinkToUserId(request.resource.data.userId)));
      allow update, delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || hasAuthLinkToUserId(resource.data.userId)));
    }

    // 21. Auth link registry for legacy data migration
    match /user_auth_links/{authUid} {
      allow read: if isAdmin() || (isSignedIn() && authUid == request.auth.uid);
      allow create, update: if isSignedIn()
        && authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 22. Daily quiz bonus status for LIFF Voyage Metrics notification
    match /daily_bonus_quiz/{dateKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/daily_bonus_quiz/$(dateKey))
        && request.resource.data.claimed == true
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.claimedBy is string
        && request.resource.data.amount == 0.1
        && request.resource.data.dateKey == dateKey;
      allow update, delete: if isAdmin();
    }

    // 26. Exam Sessions (Multi-user collaborative exam, TBL/GRAT-style — V1 Phase 2)
    // Trust model: <10 users per session, private session link as the access gate, all
    // users are signed-in (LIFF + Firebase anonymous auth). Permissive update is
    // acceptable here because:
    //   - Admin is the only role that creates/deletes sessions.
    //   - The session link is shared privately (LINE chat) within the trusted intern pool.
    //   - Field-level diff guards (e.g. only host can change state) require
    //     request.resource.data.diff(resource.data).changedKeys() checks that complicate
    //     the rule — out of scope for the lobby ship; revisit when adding vote logic
    //     in Phase 3 if peer tampering becomes a concern.
    match /exam_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    // 25. Unified Submissions (V91.62+ Phase 2 — Case/Work/Quiz/Quest/Reflective/Learning Note)
    // V94.09: Match reflective_logs (rule 13) pattern — single-query onSnapshot at
    // loadUnifiedSubmissions() (public/index.html:9912) uses where('userId','==',userId)
    // only. Stricter cases-style rule (V94.08 attempt) required TWO parallel queries
    // (authUid + userId, see loadMyCases at line 11581-11583); single-query against the
    // owner-or-linked OR rule was rejected by Firestore's query-alignment check.
    // Privacy posture: same as reflective_logs — any signed-in user can read all
    // submissions. Tightening would require allow-get/allow-list split or JS query
    // refactor (out of scope for this hotfix).
    match /submissions/{docId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();

      // V91.75 γ.4a: Conversation thread between admin and student on a review.
      // Each message records its author so a student can never impersonate admin.
      // Read is open to any signed-in user (matches parent rule); create requires
      // authorUid == request.auth.uid; update/delete admin-only.
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000;
        allow update, delete: if isAdmin();
      }
    }

    // 26. Taxonomy (V94.53 Phase 1) — admin-editable disease-system taxonomy.
    // Read is public/open so case-taxonomy.js can fetch the overlay before
    // any user auth (LIFF profile flow is async — taxonomy must be available
    // for case-submit dropdown render). The data is non-PII config; same
    // posture as a static .js asset. Write is admin-only (Phase 2 wires the UI).
    match /taxonomy/{type} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 27. TTS Pronunciation Dictionary (OmniVoice Phase 3.1) — global shared
    // CMU phoneme cache. A single doc (tts_pronunciation_dict/shared) holds a
    // word→ARPAbet map so Datamuse lookups persist across sessions for every
    // admin. CMU phonemes are objective pronunciation facts, not per-admin
    // data, so the doc is shared (read + write by any admin) rather than
    // uid-scoped like tts_voice_presets.
    match /tts_pronunciation_dict/{docId} {
      allow read, write: if isAdmin();
    }

    // 28. Drug Codex (PONEGLYPH evolution — Phase 1, V93.96).
    // Published A-Z clinical drug reference. Read by any signed-in user (intern
    // reads it as a learning resource — LIFF auth is the access gate, matching
    // reflective_logs/quiz_attempts posture). Write is admin-only; Phase 2
    // wires the ⚙️ CRUD modal. Drafts authored by interns flow through
    // drug_codex_drafts/ and are copied here on admin approval (Phase 5).
    match /drug_codex/{drugId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // 28a. Per-drug discussion comments (Phase 6 — V94.93).
      // Mirrors quiz_discussions/{id}/comments posture: any signed-in user
      // can read + post; admin moderates (delete bad content). Owner cannot
      // edit or delete own comment — keeps audit trail clean and prevents
      // post-then-edit-to-malicious abuse.
      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // 29. Drug Codex Drafts (intern submissions awaiting admin moderation).
    // Workflow: intern creates {status:'pending'} → admin reviews/edits → on
    // approve, admin copies the doc to drug_codex/ and flips status to
    // 'approved' (or 'rejected'). Owner intern can read/update/delete only
    // while status='pending'; once admin moves it past pending the draft is
    // locked to admin to preserve the moderation trail.
    //
    // Server-side guards (Phase 1, minimal):
    //   - submittedBy is locked to request.auth.uid on create.
    //   - Initial status must be 'pending'; intern cannot self-approve.
    //   - genericName is required (basic shape check; full field validation
    //     happens client-side until Phase 5 wires the submit form).
    match /drug_codex_drafts/{draftId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.submittedBy == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.genericName is string
        && request.resource.data.genericName.size() > 0;
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.submittedBy == resource.data.submittedBy);
      allow delete: if isAdmin()
        || (isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == 'pending');
    }

    // 30. Disease Codex (mirror of Drug Codex Rule 28, for diseases — Phase 1).
    // Published A-Z clinical disease reference. Read by any signed-in user
    // (intern reads it as a learning resource — LIFF auth is the access gate,
    // matching drug_codex / reflective_logs posture). Write is admin-only;
    // Phase 2a wires the ⚙️ CRUD modal. Drafts authored by interns would flow
    // through disease_codex_drafts/ and be copied here on admin approval (a
    // future phase). No per-disease discussion subcollection — out of scope
    // per the Disease Codex plan (discussion comments cut).
    match /disease_codex/{diseaseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 32. AI usage metrics (V95.96 observability) — one doc per Bangkok day,
    // ai_usage/{YYYY-MM-DD}, written ONLY by callAIProxy via the Admin SDK (which
    // bypasses these rules). Client gets admin-only read for the dashboard; no
    // client write so interns/anonymous can't tamper with the token counters.
    match /ai_usage/{dateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 32c. LINE push quota counter (V97.53 observability) — one doc per Bangkok
    // MONTH, line_usage/{YYYY-MM}, written ONLY by pushLineFlex via the Admin SDK
    // (which bypasses these rules). Backs the dashboard's "X/300 this month"
    // quota card. Admin-only read; no client write, so the quota figure the
    // admin relies on can't be tampered with from a browser.
    match /line_usage/{monthId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 32b. AI quality/eval metrics (V96.05 Evaluation pillar) — one doc per
    // Bangkok day, ai_evals/{YYYY-MM-DD}. UNLIKE ai_usage, the accept/reject
    // signals originate in the admin UI (Apply / dismiss / save), so the client
    // writes them directly via merge+increment. Admin-only read AND write —
    // interns/anonymous never touch the quality counters.
    match /ai_evals/{dateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 31. Disease Codex Drafts (intern submissions awaiting moderation).
    // Scaffolded in Phase 1 to mirror drug_codex_drafts Rule 29; no UI ships
    // until a future intern-submission phase. The required shape field is
    // diseaseName (vs Drug Codex's genericName).
    match /disease_codex_drafts/{draftId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.submittedBy == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.diseaseName is string
        && request.resource.data.diseaseName.size() > 0;
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.submittedBy == resource.data.submittedBy);
      allow delete: if isAdmin()
        || (isSignedIn()
          && resource.data.submittedBy == request.auth.uid
          && resource.data.status == 'pending');
    }

    // 32. Certificate registry (V96.83 Phase 3). Public verify page fetches a
    // single doc by its full number (running seq + random suffix, so numbers
    // are not enumerable); list stays admin-only to prevent scraping.
    match /certificates/{certNo} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 33. Certificate counter (running number source, admin-only).
    match /cert_meta/{docId} {
      allow read, write: if isAdmin();
    }

    // 34. Product Listings (V96.37 Phase 1) — intern-submitted products for the
    // shop's LINE MAN storefront. Same ownership model as /cases (rule 17):
    // owner reads their own, admin reads all, only admin can moderate.
    match /product_listings/{docId} {
      allow read: if isAdmin() || isOwnerByAuthUid() || hasLinkedEffectiveUserId();
      allow create: if isSignedIn() && request.resource.data.authUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 35. Review Links (Explore tab, Beri Phase 1) — admin-curated external
    // links (LINE MAN shops, YouTube, etc.). Same posture as /quizzes (rule 8).
    match /review_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 35b. Review Link Clicks — one doc per (link, user), id `${linkId}_${userId}`,
    // dedupes the one-time Beri credit and lets the client check "already earned"
    // for its own doc by direct get(). Same posture as /quiz_attempts (rule 9).
    match /review_link_clicks/{clickId} {
      allow create, update, read: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 35c. Beri daily cap counter — one doc per user per Bangkok day, id
    // `${userId}_${dateKey}`, written inside the same client transaction as
    // review_link_clicks + users/{uid}.beri (see index.html explOpenLink) so the
    // per-day Beri cap from Explore Links is enforced atomically.
    match /beri_daily/{docId} {
      allow create, update, read: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 36. Beri Rewards (Phase 2 shop catalog, "A Shop for Killers") — admin CRUD
    // catalog. `stock` is the one field a non-admin may touch via update,
    // decremented atomically inside the same client transaction as the
    // redemption doc + users/{uid}.beri debit (see index.html redeemBeriReward)
    // — this SDK (firestore-compat v8) has no query-inside-transaction support,
    // so a live stock counter field is the only way to enforce it atomically.
    match /beri_rewards/{rewardId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    // 36b. Beri Redemptions — intern creates their own request (inside the same
    // transaction as the beri_rewards stock decrement + users/{uid}.beri debit);
    // only admin can update (fulfill/deny) or delete, so an intern can never
    // self-approve or self-refund their own request.
    match /beri_redemptions/{redemptionId} {
      allow create, read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 35d. Beri Adjustments — admin-only audit log for manually crediting/debiting
    // a user's Beri (e.g. an offline/real-world purchase). Kept out of
    // checkin_logs deliberately — several dashboards sum checkin_logs amounts
    // assuming score, not Beri. Admin-only end to end, unlike the other Beri
    // collections above (no intern write path at all here).
    match /beri_adjustments/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
