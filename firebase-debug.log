[debug] [2026-04-19T15:14:46.628Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/intern-port-edfa7/rulesets {"name":"projects/intern-port-edfa7/rulesets/57d74a34-d983-474f-a32f-e079233ac85c","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ✅ ฟังก์ชันเช็ค Admin\r\n    function isAdmin() {\r\n      return request.auth != null && request.auth.token.email == 'medlifeplus@gmail.com';\r\n    }\r\n\r\n    // 1. Users\r\n    match /users/{userId} {\r\n      allow read, create, update: if true;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // 2. Works\r\n    match /works/{workId} {\r\n      allow read, create: if true;\r\n      allow update, delete: if true; \r\n    }\r\n\r\n    // 3. Quests\r\n    match /quests/{questId} {\r\n      allow read: if true;\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    // 4. Quest Submissions\r\n    match /quest_submissions/{subId} {\r\n      allow read, create, update: if true;\r\n      allow delete: if true; \r\n    }\r\n    \r\n    // 5. Check-in Logs\r\n    match /checkin_logs/{logId} {\r\n      allow read, create: if true;\r\n      allow update, delete: if isAdmin();\r\n    }\r\n    \r\n    // 6. Side Quests\r\n    match /side_quests/{taskId} {\r\n      allow read: if true;\r\n      allow create, update: if true;\r\n      allow delete: if isAdmin();\r\n      \r\n      match /comments/{commentId} {\r\n        allow read, create: if true;\r\n      }\r\n    }\r\n    \r\n    // 7. Reports\r\n    match /reports/{reportId} {\r\n      allow create: if true;\r\n      allow read, update, delete: if isAdmin();\r\n    }\r\n\r\n    // 8. Quizzes\r\n    match /quizzes/{quizId} {\r\n      allow read: if true; \r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    // 9. Quiz Attempts\r\n    match /quiz_attempts/{attemptId} {\r\n      allow create, update, read: if true;\r\n      allow delete: if true;\r\n    }\r\n\r\n    // 10. Poll Responses\r\n    match /poll_responses/{pollId} {\r\n      allow create: if true;\r\n      allow read, update, delete: if isAdmin();\r\n    }\r\n\r\n    // 11. Pre Users\r\n    match /pre_users/{docId} {\r\n      allow read, create, update: if true;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // 12. Quiz Feedback\r\n    match /quiz_feedback/{docId} {\r\n      allow read, create: if true;\r\n      allow update, delete: if isAdmin();\r\n    }\r\n\r\n    // 13. Reflective Logs\r\n    match /reflective_logs/{docId} {\r\n      allow read, create: if true;\r\n      allow update, delete: if true; \r\n    }\r\n\r\n    // 🔥 14. Knowledge Base (เพิ่มใหม่สำหรับระบบวิจัย V86.35)\r\n    match /knowledge_base/{docId} {\n      allow read, write: if isAdmin();\n    }\n\n    // 15. Podcast Studio\n    match /podcasts/{docId} {\n      allow read, write: if isAdmin();\n    }\n\n    // 16. Admin metadata (e.g. storage usage counters)\n    match /_meta/{docId} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-19T15:14:49.934335Z","metadata":{"services":["cloud.firestore"]}}
