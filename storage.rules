rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors isAdmin() in firestore.rules: custom claim first, email fallback.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'medlifeplus@gmail.com'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // OmniVoice Phase 2.1 — voice-clone reference audio (content-addressed by SHA-256).
    match /voice-refs/{fileName} {
      allow read, write: if isAdmin();
    }

    // Quill rich-text editor images (content-addressed by SHA-256).
    match /editor-images/{fileName} {
      allow read, write: if isAdmin();
    }

    // Podcast Studio episode audio.
    match /podcasts/{fileName} {
      allow read, write: if isAdmin();
    }

    // Drug Codex PK Visual (ADMET infographic, content-addressed by SHA-256).
    // Phase 2 V94.63. Read uses Firebase Storage download tokens, so intern
    // viewers don't need read permission here — admin write + admin read for
    // re-fetch / orphan-scan tooling is enough.
    match /pk-visuals/{fileName} {
      allow read, write: if isAdmin();
    }

    // Disease Codex Pathophysiology Visual (content-addressed by SHA-256).
    // Phase 6 V94.95. Same model as pk-visuals: intern viewers read via Storage
    // download tokens (no rule read needed); admin write + admin read for re-fetch.
    match /patho-visuals/{fileName} {
      allow read, write: if isAdmin();
    }

    // Product Listing photos (V96.39 Phase 5), content-addressed by SHA-256.
    // This is the FIRST non-admin write path in this file — interns authenticate
    // anonymously, so "signed in" is the strongest identity gate available. The
    // real protection is the pair of hard caps below plus create-only access:
    //   - 2 MB ceiling; the client resizes to <=1280px JPEG before uploading, so
    //     a real photo lands far under it and anything larger is not a photo.
    //   - image/jpeg|png|webp only.
    //   - create but NOT update or delete, so one intern can never overwrite or
    //     remove another listing's photo. Admin retains both for cleanup.
    // Content addressing means a re-upload of the same bytes resolves to the same
    // object, which the client probes for before uploading at all.
    match /product-images/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if isAdmin();
    }

    // "Know Yourself" NERIS result screenshots (V96.94). Content-addressed by
    // SHA-256 like the paths above, but scoped under the uploader's own auth
    // uid — NOT flat like product-images. A personality result can carry a name
    // or an email if the intern crops carelessly (the card warns them not to),
    // so one intern must not be able to fetch another's even knowing the hash,
    // and the flat layout gave exactly that away to anyone signed in.
    // {ownerUid} is the ANONYMOUS Firebase auth uid, not the LINE user id that
    // keys users/{uid} — Storage rules cannot read Firestore, so the auth uid is
    // the only identity available here. Admin reads by the stored path.
    // 1 MB rather than product-images' 2 MB: this is a cropped screenshot, not a
    // camera photo, and the client downscales before uploading.
    match /personality-proofs/{ownerUid}/{fileName} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == ownerUid);
      allow create, update: if isSignedIn() && request.auth.uid == ownerUid
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == ownerUid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
